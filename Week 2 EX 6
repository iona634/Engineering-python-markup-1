    "\n",
    "def triangle_area(vertices):\n",
    "    # Check that there are exactly 3 vertices\n",
    "    if len(vertices) != 3:\n",
    "        raise ValueError(\"A triangle must have 3 vertices\")\n",
    "\n",
    "    # Check that each vertex has 2 coordinates\n",
    "    for vertex in vertices:\n",
    "        if len(vertex) != 2:\n",
    "            raise ValueError(\"Each vertex must have 2 coordinates\")\n",
    "\n",
    "    # Extract the coordinates\n",
    "    x1, y1 = vertices[0]\n",
    "    x2, y2 = vertices[1]\n",
    "    x3, y3 = vertices[2]\n",
    "\n",
    "    # Calculate the area\n",
    "    area = abs(x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2)) / 2\n",
    "\n",
    "    return area\n",
    "\n",
    "\n",
    "# Test the function\n",
    "triangle = [(7, 0), (4, 0), (0, 3)]\n",
    "\n",
    "print(\"Triangle area:\", triangle_area(triangle))\n"
   ]
