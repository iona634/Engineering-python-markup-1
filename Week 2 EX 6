    "\n",
    "def polygon_area(vertices):\n",
    "    # Check that there are at least 3 vertices\n",
    "    if len(vertices) < 3:\n",
    "        raise ValueError(\"A polygon must have at least 3 vertices\")\n",
    "\n",
    "    area = 0\n",
    "    n = len(vertices)\n",
    "\n",
    "    for i in range(n):\n",
    "        x1, y1 = vertices[i]\n",
    "        x2, y2 = vertices[(i + 1) % n]\n",
    "\n",
    "        area += x1 * y2 - x2 * y1\n",
    "\n",
    "    return abs(area) / 2\n",
    "\n",
    "\n",
    "# Test 1: Rectangle (not at the origin)\n",
    "rectangle = [(2, 2), (6, 2), (6, 5), (2, 5)]\n",
    "print(\"Rectangle area:\", polygon_area(rectangle))\n",
    "\n",
    "# Test 2: Triangle (not at the origin)\n",
    "triangle = [(1, 1), (5, 1), (1, 4)]\n",
    "print(\"Triangle area:\", polygon_area(triangle))\n",
    "\n",
    "# Test 3: Square\n",
    "square = [(2, 2), (4, 2), (4, 4), (2, 4)]\n",
    "print(\"Square area:\", polygon_area(square))\n"
