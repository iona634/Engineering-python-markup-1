    "    # Create a list of zeros\n",
    "    n = len(x)\n",
    "    z = [0] * n\n",
    "\n",
    "    # Add vectors\n",
    "    for i in range(n):\n",
    "        z[i] = x[i] + y[i]\n",
    "\n",
    "    return z\n",
