    "        raise ValueError(\"The interval must bracket a root\")\n",
    "\n",
    "    num_it = 0\n",
    "\n",
    "    while num_it < max_it:\n",
    "        x = (x0 + x1) / 2\n",
    "        f_x = f(x)\n",
    "        num_it = num_it + 1\n",
    "\n",
    "        if abs(f_x) < tol:\n",
    "            return x, f_x, num_it\n",
    "\n",
    "        if f(x0) * f_x < 0:\n",
    "            x1 = x\n",
    "        else:\n",
    "            x0 = x\n",
    "\n",
    "    return x, f_x, num_it\n",
    "\n",
    "x, f_x, num_it = compute_root(f, x0=0, x1=8,\n",
