    "\n",
    "import random\n",
    "\n",
    "# (a) Dice roll function\n",
    "def dice_roll(n):\n",
    "    return random.randint(1, n)\n",
    "\n",
    "\n",
    "# Tests to check the dice roll gives a valid result\n",
    "for n in range(1, 20):\n",
    "    for j in range(100):\n",
    "        value = dice_roll(n)\n",
    "        assert value >= 1 and value <= n\n",
    "\n",
    "\n",
    "# (b) Test for fairness of a six-sided die\n",
    "rolls = 60000\n",
    "counts = [0] * 6\n",
    "\n",
    "for j in range(rolls):\n",
    "    value = dice_roll(6)\n",
    "    counts[value - 1] += 1\n",
    "\n",
    "for i in range(6):\n",
    "    print(\"Number\", i + 1, \":\", counts[i],\n",
    "          \"rolls; proportion =\", counts[i] / rolls)\n"
   ]
