    "\n",
    "import random\n",
    "import statistics\n",
    "\n",
    "# Function to estimate variance\n",
    "def estimate_variance(x):\n",
    "    n = len(x)\n",
    "    mean = sum(x) / n\n",
    "    mean_square = sum(value**2 for value in x) / n\n",
    "\n",
    "    variance = (mean_square - mean**2) * n / (n - 1)\n",
    "\n",
    "    return variance\n",
    "\n",
    "\n",
    "# Question 1: Mean 10, standard deviation 3\n",
    "random.seed(\"im634\")\n",
    "\n",
    "mu = 10.0\n",
    "sigma = 3.0\n",
    "N = 1_000_000\n",
    "\n",
    "x = [random.gauss(mu, sigma) for i in range(N)]\n",
    "\n",
    "print(\"Question 1\")\n",
    "print(\"Estimated variance:\", estimate_variance(x))\n",
    "print(\"Expected variance:\", sigma**2)\n",
    "\n",
    "\n",
    "# Question 2: Mean 5 million, standard deviation 2\n",
    "random.seed(\"im634\")\n",
    "\n",
    "mu = 5e6\n",
    "sigma = 2.0\n",
    "N = 1_000_000\n",
    "\n",
    "x = [random.gauss(mu, sigma) for i in range(N)]\n",
    "\n",
    "my_variance = estimate_variance(x)\n",
    "python_variance = statistics.variance(x)\n",
    "\n",
    "print()\n",
    "print(\"Question 2\")\n",
    "print(\"My variance estimate:\", my_variance)\n",
    "print(\"statistics.variance:\", python_variance)\n",
    "print(\"Expected variance:\", sigma**2)\n"
   ]
